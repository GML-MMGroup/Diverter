{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/session_start.py\"",
            "commandWindows": "py -3 \"$env:PLUGIN_ROOT\\hooks\\session_start.py\"",
            "timeout": 5,
            "statusMessage": "Loading Diverter Session Contract..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/user_prompt_submit.py\"",
            "commandWindows": "py -3 \"$env:PLUGIN_ROOT\\hooks\\user_prompt_submit.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
